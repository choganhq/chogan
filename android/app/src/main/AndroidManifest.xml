<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      تنها مجوز اپ: لرزش، برای بازخورد لمسی که در تنظیمات قابل خاموش شدن است.
      به‌خصوص مجوز اینترنت اضافه نمی‌شود؛ بازی‌ها کاملاً آفلاین‌اند و فایل‌ها
      از assets داخل خود برنامه بار می‌شوند.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Installable on Android TV too (#1210). Both stay optional: "required" would hide the
         app from phones (leanback) or from every TV (touchscreen, assumed required if unsaid). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme.Launch">

        <activity
            android:name="io.github.choganhq.chogan.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launch"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- without it a TV's home screen does not list the app -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the result card PNG to the share sheet without any storage permission (#168) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>

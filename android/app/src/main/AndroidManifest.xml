<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      تنها مجوز اپ: لرزش، برای بازخورد لمسی که در تنظیمات قابل خاموش شدن است.
      به‌خصوص مجوز اینترنت اضافه نمی‌شود؛ بازی‌ها کاملاً آفلاین‌اند و فایل‌ها
      از assets داخل خود برنامه بار می‌شوند.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme.Launch">

        <activity
            android:name="io.github.choganhq.chogan.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Launch"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

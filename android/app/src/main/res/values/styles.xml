<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Capacitor's AppTheme.NoActionBar extends Theme.AppCompat, a dark theme, and the
         WebView takes prefers-color-scheme from the app theme: the "auto" theme saw dark
         on every phone (#1009). DayNight follows the device; the window background is only
         what shows before the WebView is up. -->
    <style name="AppTheme.Launch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/launchBackground</item>
    </style>
</resources>

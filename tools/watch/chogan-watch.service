[Unit]
Description=chogan issue watcher (starts Claude only when GitHub has something new)

[Service]
Type=oneshot
WorkingDirectory=/home/dev/projects/personal/chogan/watch
ExecStart=/home/dev/projects/personal/chogan/chogan/tools/watch/watch.sh
# A run can build several issues in a row; the default 90 s start timeout would kill it.
TimeoutStartSec=14h

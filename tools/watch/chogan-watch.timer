[Unit]
Description=Hourly chogan issue watcher (Mon-Fri 17:00-07:00, all day Sat/Sun)

[Timer]
OnCalendar=Mon..Fri *-*-* 17..23:00:00
OnCalendar=Mon..Fri *-*-* 00..07:00:00
OnCalendar=Sat,Sun *-*-* *:00:00
# watch.sh re-checks the window itself, so a boot catch-up outside it exits at once.
Persistent=true

[Install]
WantedBy=timers.target

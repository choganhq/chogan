// issues.playchogan.com (#768): a read-only mirror of the public issues of
// choganhq/chogan for players who cannot reach GitHub. Deployed by hand from this
// folder to the Hossein account (CLOUDFLARE_ACCOUNT_ID=cbaf7c8b254ee4af435b9d6e32d2c6f1)
// with `npx wrangler@4 deploy`. Nothing in CI deploys it.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "playchogan-issues",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // A Custom Domain: Cloudflare creates the DNS record and the certificate itself.
  "routes": [{ "pattern": "issues.playchogan.com", "custom_domain": true }]
  // Optional secret, set with `npx wrangler secret put GITHUB_TOKEN`. Without it the
  // Worker reads GitHub anonymously (60 calls an hour per address, shared with every
  // other Worker on that address). A fine-grained token with no repository access at
  // all ("Public repositories (read-only)") is enough; it never needs write access.
  // The list is cached for five minutes, so a visitor never costs GitHub a call.
}

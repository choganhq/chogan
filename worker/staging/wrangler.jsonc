// The staging web app (#762), deployed only by the staging job in
// .github/workflows/test.yml from the staging branch. Production stays on GitHub
// Pages. The account comes from CLOUDFLARE_ACCOUNT_ID in that job, not from here.
{
  "name": "chogan-staging",
  "main": "index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "../../www",
    "binding": "ASSETS",
    // index.js maps folders to index.html the way Pages does; see the note there
    "html_handling": "none",
    "not_found_handling": "none",
    // so every response, files included, carries the noindex header
    "run_worker_first": true
  },
  // Its own origin: staging must never share localStorage or Cache Storage with
  // production, which is why #55 once refused a same-origin path.
  "routes": [{ "pattern": "staging.playchogan.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
